rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow access to users collection
    match /users/{userId} {
      allow read, write: if true;
      
      // Permissions for friendRequests subcollection
      match /friendRequests/{requestId} {
        allow read, write: if true;
      }

      // Permissions for challenges subcollection
      match /challenges/{challengeId} {
        allow read, write: if true;
      }

      // Permissions for notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if true;
      }
      
      // Permissions for reminders subcollection
      match /reminders/{reminderId} {
        allow read, write: if true;
      }

      // Permissions for mood_selections subcollection
      match /mood_selections/{moodId} {
        allow read, write: if true;
      }

      // Permissions for mental_states subcollection
      match /mental_states/{stateId} {
        allow read, write: if true;
      }
      
      // Permissions for water intake history
      match /waterIntakeHistory/{entryId} {
        allow read, write: if true;
      }
      
      // Permissions for folders and journals
      match /Folders/{folderId} {
        allow read, write: if true;
      }
      
      match /Journals/{journalId} {
        allow read, write: if true;
      }
      
      match /history/{historyId} {
        allow read, write: if true;
      }
      
      match /tasks/{taskId} {
        allow read, write: if true;
      }
      
      match /foodLogs/{logId} {
        allow read, write: if true;
      }
    }
    
    // Allow access to friends collection
    match /friends/{friendId} {
      allow read, write: if true;
    }
    
    // Allow public read/write access to all chats and messages
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // Allow public read/write access to stickers
    match /stickers/{stickerId} {
      allow read, write: if true;
    }
    
    // Public data access
    match /publicData/{docId} {
      allow read, write: if true;
    }
    
    // Workout data access
    match /workouts/{workoutId} {
      allow read, write: if true;
    }
    
    // Challenge icons access
    match /challenges_icons/{iconId} {
      allow read, write: if true;
    }
    
    // Shared challenges collection for timer synchronization
    match /shared_challenges/{challengeId} {
      allow read, write: if true;
    }

    // General challenges collection
    match /challenges/{challengeId} {
      allow read, write: if true;
    }
  }
}
